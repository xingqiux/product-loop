exports[`JSON Schema > queueEvent 能导出，结果和快照相同 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "pattern": "\\S",
      "type": "string",
    },
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string",
    },
    "from": {
      "enum": [
        "待办",
        "进行中",
        "等待",
        "已完成",
        "已取消",
      ],
      "type": "string",
    },
    "item": {
      "pattern": "^Q[1-9]\\d*$",
      "type": "string",
    },
    "note": {
      "pattern": "\\S",
      "type": "string",
    },
    "round": {
      "pattern": "^v[1-9]\\d*-(?:构思|使用|检查|落地|提升)-[1-9]\\d*$",
      "type": "string",
    },
    "to": {
      "enum": [
        "待办",
        "进行中",
        "等待",
        "已完成",
        "已取消",
      ],
      "type": "string",
    },
  },
  "required": [
    "item",
    "at",
    "to",
    "actor",
  ],
  "type": "object",
}
`;

