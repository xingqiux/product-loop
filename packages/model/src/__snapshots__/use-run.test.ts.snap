              },
              "required": [
                "step",
                "do",
                "expect",
                "result"
              ],
              "additionalProperties": false
            },
            "description": "这个场景的每一步。要看排版的步骤，在几个宽度下各写一项。"
          }
        },
        "required": [
          "scene",
          "steps"
        ],
        "additionalProperties": false
      },
      "description": "这次运行走到的场景，每个场景一项。"
