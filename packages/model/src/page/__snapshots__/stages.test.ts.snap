    "where": {
      "additionalProperties": false,
      "properties": {
        "scene": {
          "description": "场景编号，例如 S3。",
          "pattern": "^S[1-9][0-9]*$",
          "type": "string",
        },
        "step": {
          "description": "步号，从 1 数，和主线里这个场景的步骤编号相同。",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "scene",
        "step",
      ],
      "type": "object",
    },
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "构思阶段的区块：先对齐、场景清单、设计规范、疑问、参考。",
  "properties": {
    "align": {
      "description": "先对齐：这一页的选项要用到的新词。每个词写意思和例子，用户点明白或不明白。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "diagram": {
            "$ref": "#/$defs/diagram",
            "description": "一张图，文字讲不清时用。",
          },
          "example": {
            "description": "例子，这个项目里的一件真事。",
            "pattern": "\\S",
            "type": "string",
          },
          "id": {
            "$ref": "#/$defs/cardId",
            "description": "卡片编号，小写英文加短横。不写时由命令按标题生成。",
          },
          "meaning": {
            "description": "意思，一句话，用大白话。",
            "pattern": "\\S",
            "type": "string",
          },
          "name": {
            "description": "术语的名称，全篇只用这一个。",
            "pattern": "\\S",
            "type": "string",
          },
          "queue": {
            "$ref": "#/$defs/queueRefs",
            "description": "这张卡处理的队列事项，编号的数组，例如 ["Q12"]。拿出来又成立的事，每件都要写进某张卡。",
          },
          "usedIn": {
            "description": "用到它的疑问卡的标题，要和本页的标题对得上。",
            "items": {
              "pattern": "\\S",
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "name",
          "usedIn",
          "meaning",
          "example",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "asks": {
      "description": "疑问：要用户定的事，或者要追问的事。每张卡一件事。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "design": {
            "const": true,
            "description": "设计类的卡写 true，指长什么样、怎么摆的问题。只有构思阶段会查来源和草稿。",
            "type": "boolean",
          },
          "diagrams": {
            "description": "图表。种类要和内容对得上，例如流程配流程图。",
            "items": {
              "$ref": "#/$defs/diagram",
            },
            "minItems": 1,
            "type": "array",
          },
          "dropped": {
            "$ref": "#/$defs/dropped",
            "description": "想过又排除的方向，每个写名称和一句原因。用户可以在备注里点名捞回来。",
          },
          "evidence": {
            "description": "证据，画在卡片右边。只放能看的东西，不放说明文字。一项也写成数组。",
            "items": {
              "$ref": "#/$defs/evidence",
            },
            "minItems": 1,
            "type": "array",
          },
          "flow": {
            "description": "操作流程，每步一句，画成一串带箭头的步骤。",
            "items": {
              "pattern": "\\S",
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "id": {
            "$ref": "#/$defs/cardId",
            "description": "卡片编号，小写英文加短横。不写时由命令按标题生成。",
          },
          "image": {
            "$ref": "#/$defs/figure",
            "description": "一张图，直接显示在右边。",
          },
          "mock": {
            "description": "中保真线稿，画改完的样子，用真文字，HTML 片段。可用的积木见 ploop page schema --blocks。",
            "pattern": "\\S",
            "type": "string",
          },
          "mockCaption": {
            "description": "线稿下面的一句说明，只能和 mock 一起写。",
            "pattern": "\\S",
            "type": "string",
          },
          "only": {
            "const": true,
            "description": "只有一个方向站得住时写 true。options 只放这一个，dropped 列出排除的方向。",
            "type": "boolean",
          },
          "options": {
            "description": "选项，两到三个。每个选项按 rows 逐行写差别。不写选项时，这张卡只有备注框，用来追问已经发生的事。",
            "items": {
              "$ref": "#/$defs/option",
            },
            "minItems": 1,
            "type": "array",
          },
          "queue": {
            "$ref": "#/$defs/queueRefs",
            "description": "这张卡处理的队列事项，编号的数组，例如 ["Q12"]。拿出来又成立的事，每件都要写进某张卡。",
          },
          "research": {
            "additionalProperties": false,
            "description": "调研分档。来源里有外面的东西的疑问卡必填。先定下查多深，再去查。",
            "properties": {
              "approved": {
                "description": "深查时写问句和检索计划是哪个阶段给用户批的，例如第 2 版的构思阶段。",
                "pattern": "\\S",
                "type": "string",
              },
              "reason": {
                "description": "不查时写理由，说明这一条为什么不用查。",
                "pattern": "\\S",
                "type": "string",
              },
              "tier": {
                "description": "不查、快查、深查三选一。不查要写 reason，深查要写 approved。",
                "enum": [
                  "不查",
                  "快查",
                  "深查",
                ],
                "type": "string",
              },
            },
            "required": [
              "tier",
            ],
            "type": "object",
          },
          "rows": {
            "description": "选项之间有差别的地方，每处一个名称，不超过八个字。选项的 diffs 按这个顺序一行对一行。",
            "items": {
              "pattern": "\\S",
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "shared": {
            "$ref": "#/$defs/shared",
            "description": "几个选项共同的部分，只写一遍。有两个以上选项时必填。",
          },
          "sources": {
            "description": "这张卡的依据，至少一条。每条只写一样东西。没看过的不写。",
            "items": {
              "$ref": "#/$defs/source",
            },
            "minItems": 1,
            "type": "array",
          },
          "stance": {
            "$ref": "#/$defs/stance",
            "description": "我的看法：选哪个、因为什么。先写完所有选项，最后才写看法。",
          },
          "tag": {
            "description": "一个短语，说这条属于哪一类，显示在标题旁边。例如检查的三个根问题之一。",
            "pattern": "\\S",
            "type": "string",
          },
          "title": {
            "description": "一个名字，不超过 16 个字，不写成句子。说这张卡是哪件事，解释写进 why。",
            "pattern": "\\S",
            "type": "string",
          },
          "where": {
            "$ref": "#/$defs/where",
            "description": "这件事出现在主线的哪个场景的第几步。发现问题和提升必填，疑问可以不写。",
          },
          "why": {
            "description": "含义随卡的种类变。疑问写待决定的事，发现问题写哪里不对，提升写替用户解决什么。",
            "pattern": "\\S",
            "type": "string",
          },
        },
        "required": [
          "title",
          "why",
          "sources",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "refs": {
      "description": "参考：构思调研时看过的外部资料。只给人看，不用点。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "advice": {
            "description": "建议：采用、试用、观察或不用。",
            "enum": [
              "采用",
              "试用",
              "观察",
              "不用",
            ],
            "type": "string",
          },
          "body": {
            "description": "它说了什么，以及这个项目用到了哪一条。",
            "pattern": "\\S",
            "type": "string",
          },
          "depth": {
            "description": "读到了哪一步：已读原文，或者仅摘要。",
            "enum": [
              "已读原文",
              "仅摘要",
            ],
            "type": "string",
          },
          "kind": {
            "description": "资料的种类。",
            "enum": [
              "书",
              "文章",
              "规范",
              "产品",
              "开源项目",
              "研究",
            ],
            "type": "string",
          },
          "name": {
            "description": "这份资料叫什么。",
            "pattern": "\\S",
            "type": "string",
          },
          "relevance": {
            "description": "和这个项目的相关度。",
            "enum": [
              "高",
              "中",
              "低",
            ],
            "type": "string",
          },
          "strength": {
            "description": "证据的强度。",
            "enum": [
              "强",
              "中",
              "弱",
            ],
            "type": "string",
          },
          "where": {
            "description": "用在这个项目的哪里。",
            "pattern": "\\S",
            "type": "string",
          },
        },
        "required": [
          "name",
          "kind",
          "depth",
          "relevance",
          "strength",
          "advice",
          "body",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "scenes": {
      "description": "场景清单：要用户删改的场景草稿。每个场景点保留、修改或删除。",
      "items": {
        "additionalProperties": false,
