            "description": "想过又排除的方向，每个写名称和一句原因。用户可以在备注里点名捞回来。",
          },
          "evidence": {
            "description": "证据，画在卡片右边。只放能看的东西，不放说明文字。一项也写成数组。",
            "items": {
              "$ref": "#/$defs/evidence",
            },
            "minItems": 1,
            "type": "array",
          },
          "flow": {
            "description": "操作流程，每步一句，画成一串带箭头的步骤。",
            "items": {
              "pattern": "\\S",
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "id": {
            "$ref": "#/$defs/cardId",
            "description": "卡片编号，小写英文加短横。不写时由命令按标题生成。",
          },
          "image": {
            "$ref": "#/$defs/figure",
            "description": "一张图，直接显示在右边。",
          },
          "mock": {
            "description": "中保真线稿，画改完的样子，用真文字，HTML 片段。可用的积木见 ploop page schema --blocks。",
            "pattern": "\\S",
            "type": "string",
          },
          "mockCaption": {
            "description": "线稿下面的一句说明，只能和 mock 一起写。",
            "pattern": "\\S",
            "type": "string",
          },
          "only": {
            "const": true,
            "description": "只有一个方向站得住时写 true。options 只放这一个，dropped 列出排除的方向。",
            "type": "boolean",
          },
          "options": {
            "description": "选项，两到三个。每个选项按 rows 逐行写差别。不写选项时，这张卡只有备注框，用来追问已经发生的事。",
            "items": {
              "$ref": "#/$defs/option",
            },
            "minItems": 1,
            "type": "array",
          },
          "queue": {
            "$ref": "#/$defs/queueRefs",
            "description": "这张卡处理的队列事项，编号的数组，例如 ["Q12"]。拿出来又成立的事，每件都要写进某张卡。",
          },
          "research": {
            "additionalProperties": false,
            "description": "调研分档。来源里有外面的东西的疑问卡必填。先定下查多深，再去查。",
            "properties": {
              "approved": {
                "description": "深查时写问句和检索计划是哪个阶段给用户批的，例如第 2 版的构思阶段。",
                "pattern": "\\S",
                "type": "string",
              },
              "reason": {
                "description": "不查时写理由，说明这一条为什么不用查。",
                "pattern": "\\S",
                "type": "string",
              },
              "tier": {
                "description": "不查、快查、深查三选一。不查要写 reason，深查要写 approved。",
                "enum": [
                  "不查",
                  "快查",
                  "深查",
                ],
                "type": "string",
              },
            },
            "required": [
              "tier",
            ],
            "type": "object",
          },
          "rows": {
            "description": "选项之间有差别的地方，每处一个名称，不超过八个字。选项的 diffs 按这个顺序一行对一行。",
            "items": {
              "pattern": "\\S",
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "shared": {
            "$ref": "#/$defs/shared",
            "description": "几个选项共同的部分，只写一遍。有两个以上选项时必填。",
          },
          "sources": {
            "description": "这张卡的依据，至少一条。每条只写一样东西。没看过的不写。",
            "items": {
              "$ref": "#/$defs/source",
            },
            "minItems": 1,
            "type": "array",
          },
          "stance": {
            "$ref": "#/$defs/stance",
            "description": "我的看法：选哪个、因为什么。先写完所有选项，最后才写看法。",
          },
          "tag": {
            "description": "一个短语，说这条属于哪一类，显示在标题旁边。例如检查的三个根问题之一。",
            "pattern": "\\S",
            "type": "string",
          },
          "title": {
            "description": "一个名字，不超过 16 个字，不写成句子。说这张卡是哪件事，解释写进 why。",
            "pattern": "\\S",
            "type": "string",
          },
          "where": {
            "$ref": "#/$defs/where",
            "description": "这件事出现在主线的哪个场景的第几步。发现问题和提升必填，疑问可以不写。",
          },
          "why": {
            "description": "含义随卡的种类变。疑问写待决定的事，发现问题写哪里不对，提升写替用户解决什么。",
            "pattern": "\\S",
            "type": "string",
          },
        },
        "required": [
          "title",
          "why",
          "sources",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "changes": {
      "description": "更改：落地阶段改完的事，给用户验收。每条写之前哪里不对、现在什么样，配改前改后。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "$ref": "#/$defs/figure",
            "description": "改后的图。界面的更改必填。",
          },
          "before": {
            "$ref": "#/$defs/figure",
            "description": "改前的图。界面的更改用它，之前没有图时不写。",
          },
          "fix": {
            "description": "现在什么样。",
            "pattern": "\\S",
            "type": "string",
          },
          "id": {
            "$ref": "#/$defs/cardId",
            "description": "卡片编号，小写英文加短横。不写时由命令按标题生成。",
          },
          "more": {
            "description": "补充的改后图。",
            "items": {
              "$ref": "#/$defs/figure",
            },
            "minItems": 1,
            "type": "array",
          },
          "problem": {
            "description": "之前哪里不对。",
            "pattern": "\\S",
            "type": "string",
          },
          "queue": {
            "$ref": "#/$defs/queueRefs",
            "description": "这张卡处理的队列事项，编号的数组，例如 ["Q12"]。拿出来又成立的事，每件都要写进某张卡。",
          },
          "textAfter": {
            "description": "文字的改后原文。文字的更改必填。",
            "pattern": "\\S",
            "type": "string",
          },
          "textBefore": {
            "description": "文字的改前原文。文字的更改必填，逐行对比由后端算。",
            "pattern": "\\S",
            "type": "string",
          },
          "textName": {
            "description": "文字的更改里，这一段叫什么。",
            "pattern": "\\S",
            "type": "string",
          },
          "title": {
            "description": "一个名字，不超过 16 个字，不写成句子。写这件改动叫什么，做了什么写进 fix。",
            "pattern": "\\S",
            "type": "string",
          },
        },
        "required": [
          "title",
          "problem",
          "fix",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
  },
  "title": "落地阶段的页面数据",
  "type": "object",
}
`;
