          "pattern": "\\S",
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "stance": {
      "additionalProperties": false,
      "properties": {
        "because": {
          "description": "因为什么，一句话。页面显示成我的看法是 a，因为……",
          "pattern": "\\S",
          "type": "string",
        },
        "pick": {
          "description": "看法选的是哪个选项，写它的字母。",
