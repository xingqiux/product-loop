exports[`检查阶段的 JSON Schema > 导出的样子 1`] = `
{
  "$defs": {
    "cardId": {
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string",
    },
    "diagram": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "图表库的文字定义。目录树直接写文字。",
          "pattern": "\\S",
          "type": "string",
        },
        "kind": {
          "description": "图表的种类，从取值里选，按内容配。",
          "enum": [
            "流程图",
            "时序图",
            "状态图",
            "架构图",
            "思维导图",
            "象限图",
            "时间线",
            "改前改后的结构",
            "目录树",
          ],
          "type": "string",
        },
        "title": {
          "description": "一个名字，不超过 16 个字，不写成句子。写这张图叫什么。",
          "pattern": "\\S",
          "type": "string",
        },
      },
      "required": [
        "kind",
        "title",
        "code",
      ],
      "type": "object",
    },
    "dropped": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "because": {
            "description": "为什么排除，一句话。",
            "pattern": "\\S",
            "type": "string",
