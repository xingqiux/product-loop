exports[`使用阶段的 JSON Schema > 导出的样子 1`] = `
{
  "$defs": {
    "cardId": {
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string",
    },
    "diagram": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "图表库的文字定义。目录树直接写文字。",
          "pattern": "\\S",
          "type": "string",
        },
        "kind": {
          "description": "图表的种类，从取值里选，按内容配。",
          "enum": [
            "流程图",
            "时序图",
            "状态图",
            "架构图",
            "思维导图",
            "象限图",
            "时间线",
            "改前改后的结构",
            "目录树",
          ],
          "type": "string",
        },
        "title": {
          "description": "一个名字，不超过 16 个字，不写成句子。写这张图叫什么。",
          "pattern": "\\S",
          "type": "string",
        },
      },
      "required": [
        "kind",
        "title",
        "code",
      ],
      "type": "object",
    },
    "dropped": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "because": {
            "description": "为什么排除，一句话。",
            "pattern": "\\S",
            "type": "string",
          },
          "name": {
            "description": "排除的方向叫什么。",
            "pattern": "\\S",
            "type": "string",
          },
        },
        "required": [
          "name",
          "because",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "evidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "caption": {
              "description": "图下面的一行说明。",
              "pattern": "\\S",
              "type": "string",
            },
            "keep": {
              "description": "留下的取值，会上色。其余的画成灰色。",
              "items": {
                "exclusiveMinimum": 0,
                "type": "number",
              },
              "minItems": 1,
              "type": "array",
            },
            "type": {
              "const": "尺寸",
              "type": "string",
            },
            "unit": {
              "description": "数值的单位，例如 px。",
              "pattern": "\\S",
              "type": "string",
            },
            "values": {
              "description": "要画的取值。尺寸和间距写数字，色块写名称和色值，字号写字号、字重和样张。",
              "items": {
                "exclusiveMinimum": 0,
                "type": "number",
              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "type",
            "values",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "caption": {
              "description": "图下面的一行说明。",
              "pattern": "\\S",
              "type": "string",
            },
            "type": {
              "const": "色块",
              "type": "string",
            },
            "values": {
              "description": "要画的取值。尺寸和间距写数字，色块写名称和色值，字号写字号、字重和样张。",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "hex": {
                    "description": "色值，写成 # 加十六进制数。",
                    "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                    "type": "string",
                  },
                  "name": {
                    "description": "这一格规范的名字。",
                    "pattern": "\\S",
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                  "hex",
                ],
                "type": "object",
              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
